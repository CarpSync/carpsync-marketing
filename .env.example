# Public Login CTA. Do not point this at /super-admin.
NEXT_PUBLIC_CARPSYNC_APP_URL=https://carpsync.com/next

# Resend API key used to deliver demo requests. Never commit the real key.
RESEND_API_KEY=

# Must be a sender on a Resend-verified carpsync.com domain.
RESEND_FROM_EMAIL=CarpSync <hello@carpsync.com>

# Inbox that receives demo form submissions.
DEMO_INBOX=hello@carpsync.com
